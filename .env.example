# PostgreSQL connection string (required)
DATABASE_URL=postgres://user:password@host:5432/database

# Admin seed credentials (used by netlify/functions/_db.mjs)
# If ADMIN_SEED_PASSWORD is unset, the admin seed is skipped.
ADMIN_SEED_PASSWORD=
ADMIN_SEED_EMAIL=admin@euplus.com.br

# REQUIRED for the admin panel. Signs the admin session tokens (HMAC-SHA256).
# Generate with: openssl rand -base64 32
# Without it the app fails closed: no admin session can be issued or verified,
# GET /dashboard returns public data only, and every write returns 401.
ADMIN_TOKEN_SECRET=
